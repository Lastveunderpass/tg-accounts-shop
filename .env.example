# ────────────────────────── Telegram ──────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID единственного админа (получить у @userinfobot)
ADMIN_ID=

# @username саппорта/админа (без http/t.me, можно с @ или без)
SUPPORT_USERNAME=

# ────────────────────────── CryptoBot ──────────────────────────
# Токен Crypto Pay App (https://t.me/CryptoBot -> Crypto Pay -> My Apps)
CRYPTOBOT_TOKEN=

# false = mainnet (боевой), true = testnet
CRYPTOBOT_TESTNET=false

# true = опрашивать инвойсы по таймеру (работает без домена/HTTPS)
# false = принимать webhook (требуется HTTPS-домен и CRYPTOBOT_BASE_URL)
CRYPTOBOT_POLLING=true

# Интервал опроса в секундах (только при CRYPTOBOT_POLLING=true)
CRYPTOBOT_POLL_INTERVAL=15

# Базовый публичный URL (только при CRYPTOBOT_POLLING=false), без слэша в конце
# Пример: https://shop.example.com
CRYPTOBOT_BASE_URL=

# Секрет для проверки подписи webhook (генерируется install.sh при первом запуске)
CRYPTOBOT_WEBHOOK_SECRET=

# ────────────────────────── Lolzteam Market ──────────────────────────
# Альтернативный способ оплаты (RUB через карты/СБП/Steam/Binance и т.д.).
# Создание мерчанта: lzt.market → Settings → Payments → Merchants
# API-токен: lolz.live → Account upgrades → API (нужен scope `payments`)
# Если не заполнено — Lolzteam-оплата просто отключена.
LOLZTEAM_TOKEN=
LOLZTEAM_MERCHANT_ID=

# Базовый URL API (трогать обычно не нужно)
LOLZTEAM_BASE_URL=https://prod-api.lzt.market

# true = опрашивать статусы инвойсов по таймеру (работает без домена)
# false = принимать только webhook (требуется HTTPS-домен и CRYPTOBOT_BASE_URL)
LOLZTEAM_POLLING=true
LOLZTEAM_POLL_INTERVAL=15

# Время жизни инвойса в секундах (300..43200, дефолт API = 3600 = 1 час)
LOLZTEAM_INVOICE_LIFETIME=3600

# Опциональный секрет для подписи webhook'а от Lolzteam (HMAC-SHA256 от тела).
# Если пусто — подпись не проверяется.
LOLZTEAM_CALLBACK_SECRET=

# Дефолты для первой инициализации (после старта меняются в админке без рестарта)
DEFAULT_CRYPTOBOT_ENABLED=true
DEFAULT_LOLZTEAM_ENABLED=false
DEFAULT_LOLZTEAM_SURCHARGE_PERCENT=6.0

# ────────────────────────── База ──────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/db.sqlite3

# ────────────────── Дефолты для первой инициализации ──────────────────
# (после первого запуска эти значения хранятся в БД и меняются в админке)
DEFAULT_REFERRAL_PERCENT=5
DEFAULT_MIN_TOPUP_RUB=100
DEFAULT_STOCK_LOW_THRESHOLD=5
DEFAULT_MAX_QTY_PER_ORDER=10

# Уведомления админу
DEFAULT_NOTIFY_NEW_USER=true
DEFAULT_NOTIFY_NEW_TOPUP=true
DEFAULT_NOTIFY_NEW_PURCHASE=true
DEFAULT_NOTIFY_LOW_STOCK=true
DEFAULT_NOTIFY_REFUND=true

# Дебаг-режим: ошибки шлются админу в личку. На время тестов — true.
DEBUG_MODE=true

# ────────────────────────── Прочее ──────────────────────────
TZ=Europe/Moscow
LOG_LEVEL=INFO

# Бэкапы
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=4
BACKUP_MINUTE=0

# Внутренний порт FastAPI (наружу маппится docker compose)
APP_HOST=0.0.0.0
APP_PORT=8080
